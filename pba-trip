<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Brinkley Family - PBA Trip Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; scroll-behavior: smooth; }
        #map { height: 500px; width: 100%; border-radius: 1rem; z-index: 1; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        .details-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; }
        .card-link { transition: transform 0.2s; }
        .card-link:hover { transform: translateY(-2px); }
    </style>
</head>
<body class="bg-slate-50 text-slate-900">

    <!-- Navigation -->
    <nav class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <span class="text-xl font-bold text-indigo-600">Brinkley Family Portal</span>
                <div class="flex space-x-4 md:space-x-8">
                    <button onclick="showPage('home')" class="hover:text-indigo-600 font-medium">Home</button>
                    <button onclick="showPage('logistics')" class="hover:text-indigo-600 font-medium">Travel</button>
                    <button onclick="showPage('details')" class="hover:text-indigo-600 font-medium">Explore Details</button>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        
        <!-- PAGE: HOME -->
        <section id="home" class="tab-content active space-y-8">
            <div class="text-center space-y-2">
                <h1 class="text-4xl font-extrabold tracking-tight">PBA Visit: West Palm Beach</h1>
                <p class="text-slate-500">March 4 – March 8, 2026 | 6 Kids | 1 Big Adventure</p>
            </div>

            <!-- Map Section -->
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200">
                <div class="flex flex-wrap gap-2 mb-4" id="map-filters">
                    <button onclick="filterMarkers('all')" class="filter-btn px-4 py-2 rounded-full bg-indigo-600 text-white text-sm font-medium transition shadow-md">All Spots</button>
                    <button onclick="filterMarkers('dining')" class="filter-btn px-4 py-2 rounded-full bg-white border border-slate-200 text-sm font-medium hover:bg-slate-50 transition">Dining</button>
                    <button onclick="filterMarkers('kids')" class="filter-btn px-4 py-2 rounded-full bg-white border border-slate-200 text-sm font-medium hover:bg-slate-50 transition">Educational</button>
                    <button onclick="filterMarkers('study')" class="filter-btn px-4 py-2 rounded-full bg-white border border-slate-200 text-sm font-medium hover:bg-slate-50 transition">Study/Coffee</button>
                    <button onclick="filterMarkers('church')" class="filter-btn px-4 py-2 rounded-full bg-white border border-slate-200 text-sm font-medium hover:bg-slate-50 transition">Churches</button>
                    <button onclick="filterMarkers('active')" class="filter-btn px-4 py-2 rounded-full bg-white border border-slate-200 text-sm font-medium hover:bg-slate-50 transition">Outdoors/Surf</button>
                    <button onclick="filterMarkers('arts')" class="filter-btn px-4 py-2 rounded-full bg-white border border-slate-200 text-sm font-medium hover:bg-slate-50 transition">Arts/Dance/Square</button>
                </div>
                <div id="map"></div>
                <div class="mt-3 flex justify-center gap-6 text-xs font-semibold uppercase tracking-wider text-slate-500">
                    <span class="flex items-center gap-1"><span class="w-3 h-3 bg-red-500 rounded-full"></span> The Jaxon</span>
                    <span class="flex items-center gap-1"><span class="w-3 h-3 bg-indigo-500 rounded-full"></span> PBA University</span>
                </div>
            </div>
        </section>

        <!-- PAGE: LOGISTICS -->
        <section id="logistics" class="tab-content space-y-10">
            <h2 class="text-3xl font-bold">Flight & Transport</h2>
            <div class="grid md:grid-cols-2 gap-8">
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 space-y-6">
                    <h3 class="text-xl font-bold flex items-center gap-2">Frontier Airlines</h3>
                    <div class="space-y-4">
                        <div class="border-l-4 border-indigo-500 pl-4">
                            <p class="text-xs font-bold text-slate-400">MARCH 4: DEPARTURE</p>
                            <p class="font-bold text-lg">LAX → ATL → MCO</p>
                            <p class="text-sm">Flights 4316 / 4556 | 10:33 PM – 9:57 AM</p>
                        </div>
                        <div class="border-l-4 border-indigo-200 pl-4">
                            <p class="text-xs font-bold text-slate-400">MARCH 8: RETURN</p>
                            <p class="font-bold text-lg">MCO → LAX</p>
                            <p class="text-sm">Flight 4145 | 4:02 PM – 7:01 PM</p>
                        </div>
                    </div>
                </div>
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 space-y-6">
                    <h3 class="text-xl font-bold flex items-center gap-2">Alamo Rental</h3>
                    <div class="p-4 bg-orange-50 rounded-xl border border-orange-100">
                        <p class="font-bold text-orange-900 text-lg uppercase">Toyota Sienna</p>
                        <p class="text-sm text-orange-700">Driver: Timothy Brinkley</p>
                        <p class="text-xs mt-2 font-bold text-red-600">Bring Physical Costco Card!</p>
                    </div>
                    <div class="text-sm text-slate-600">
                        <p>Pickup: Mar 5, 10:00 AM @ MCO</p>
                        <p>Dropoff: Mar 8, 2:00 PM @ MCO</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- PAGE: DETAILS -->
        <section id="details" class="tab-content space-y-12">
            <div class="flex justify-between items-end border-b border-slate-200 pb-4">
                <h2 class="text-3xl font-bold text-slate-800">Explore Details</h2>
                <p class="text-sm text-slate-500 italic">Click titles for website or map location</p>
            </div>

            <!-- Spiritual Life (Churches) -->
            <div class="space-y-6">
                <h3 class="text-2xl font-bold text-indigo-900">Spirit-Led Churches</h3>
                <div class="details-grid">
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://www.google.com/maps/search/Vineyard+Community+Church+Palm+Beaches" target="_blank" class="font-bold text-lg text-indigo-600 hover:underline">Vineyard Community Church</a>
                        <p class="text-sm font-bold mt-1 text-slate-700">Sunday @ 9:30 AM</p>
                        <p class="text-xs text-slate-500 mt-2">Pastors Doug & Maria Jones. Casual, Spirit-sensitive environment for families.</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://www.google.com/maps/search/Faith+Church+West+Palm+Beach" target="_blank" class="font-bold text-lg text-indigo-600 hover:underline">Faith Church | WPB</a>
                        <p class="text-sm font-bold mt-1 text-slate-700">Sunday @ 10:00 AM</p>
                        <p class="text-xs text-slate-500 mt-2">Dynamic worship, practical Spirit-filled teaching. High energy.</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://www.google.com/maps/search/Bridge+Church+West+Palm+Beach" target="_blank" class="font-bold text-lg text-indigo-600 hover:underline">Bridge Church</a>
                        <p class="text-sm font-bold mt-1 text-slate-700">Sunday @ 10:30 AM</p>
                        <p class="text-xs text-slate-500 mt-2">Relational & Elder-shepherded. Located very close to PBA campus.</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://www.google.com/maps/search/Journey+Church+West+Palm+Beach" target="_blank" class="font-bold text-lg text-indigo-600 hover:underline">Journey Church</a>
                        <p class="text-sm font-bold mt-1 text-slate-700">Sunday @ 9:00 AM & 11:00 AM</p>
                        <p class="text-xs text-slate-500 mt-2">Led by Pastor Scott Baugh (20+ years). Focus on experiencing God.</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://www.google.com/maps/search/Pentecostal+Tabernacle+West+Palm+Beach" target="_blank" class="font-bold text-lg text-indigo-600 hover:underline">Pentecostal Tabernacle</a>
                        <p class="text-sm font-bold mt-1 text-slate-700">Sunday @ 11:00 AM</p>
                        <p class="text-xs text-slate-500 mt-2">Deeply rooted congregation focusing on the move of the Holy Spirit.</p>
                    </div>
                </div>
            </div>

            <!-- Nature, Kayaking, Climbing -->
            <div class="space-y-6">
                <h3 class="text-2xl font-bold text-emerald-900">Nature & Adventure</h3>
                <div class="details-grid">
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://www.google.com/maps/search/Grassy+Waters+Preserve" target="_blank" class="font-bold text-lg text-emerald-600 hover:underline">Grassy Waters Preserve</a>
                        <p class="text-xs text-slate-500 mt-2">Cypress Boardwalk (stroller accessible) and the 2.5-mile Apoxee Trail.</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://www.google.com/maps/search/Riverbend+Park+Jupiter" target="_blank" class="font-bold text-lg text-emerald-600 hover:underline">Riverbend Park (Kayaking)</a>
                        <p class="text-xs text-slate-500 mt-2">Wild and Scenic Loxahatchee River. Calm water, perfect for kids.</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://projectrock.com/" target="_blank" class="font-bold text-lg text-emerald-600 hover:underline">projectROCK</a>
                        <p class="text-xs text-slate-500 mt-2">Massive indoor climbing facility. Authentic outdoor experience inside.</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://www.google.com/maps/search/John+D.+MacArthur+Beach+State+Park" target="_blank" class="font-bold text-lg text-emerald-600 hover:underline">John D. MacArthur Beach</a>
                        <p class="text-xs text-slate-500 mt-2">Pristine estuary paddling. Highly recommended for marine life viewing.</p>
                    </div>
                </div>
            </div>

            <!-- Arts, Dance, Square Dancing -->
            <div class="space-y-6">
                <h3 class="text-2xl font-bold text-pink-900">Arts, Dance & Movement</h3>
                <div class="details-grid">
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://balletflorida.org/" target="_blank" class="font-bold text-lg text-pink-600 hover:underline">Ballet Florida</a>
                        <p class="text-xs text-slate-500 mt-2">Classical dance studios with barres and mirrors for practice.</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://www.google.com/maps/search/Avenue+Pottery+West+Palm+Beach" target="_blank" class="font-bold text-lg text-pink-600 hover:underline">Avenue Pottery</a>
                        <p class="text-xs text-slate-500 mt-2">Ceramic studio with kids' clay workshops and family sessions.</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://www.google.com/maps/search/Boynton+Beach+Arts+%26+Cultural+Center" target="_blank" class="font-bold text-lg text-indigo-700 hover:underline">Castoffs Square Dance Club</a>
                        <p class="text-sm font-bold mt-1">Friday @ 7:00 PM</p>
                        <p class="text-xs text-slate-500 mt-1">Plus level with rounds. Old-school traditional square dancing.</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://www.google.com/maps/search/Fitness+Hub+Studios+West+Palm+Beach" target="_blank" class="font-bold text-lg text-pink-600 hover:underline">Fitness Hub Studios</a>
                        <p class="text-xs text-slate-500 mt-2">Gym with dedicated barre and mirror rooms. Downtown Clematis location.</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://armoryart.org/" target="_blank" class="font-bold text-lg text-pink-600 hover:underline">Armory Art Center</a>
                        <p class="text-xs text-slate-500 mt-2">Historic art hub. Fine art, painting, and ceramic workshops.</p>
                    </div>
                </div>
            </div>

            <!-- Education & Colleges -->
            <div class="space-y-6">
                <h3 class="text-2xl font-bold text-slate-700">Colleges & Schools</h3>
                <div class="details-grid">
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://www.palmbeachstate.edu/" target="_blank" class="font-bold text-lg text-slate-800 hover:underline">Palm Beach State College</a>
                        <p class="text-xs text-slate-500 mt-1">Multiple campuses (Lake Worth, Loxahatchee, PG). Workforce focus.</p>
                    </div>
                    <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm card-link">
                        <a href="https://www.pba.edu/" target="_blank" class="font-bold text-lg text-indigo-800 hover:underline">Palm Beach Atlantic Univ.</a>
                        <p class="text-xs text-slate-500 mt-1">The main destination. Christian liberal arts university on the coast.</p>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <footer class="bg-slate-100 py-12 border-t border-slate-200">
        <div class="max-w-7xl mx-auto px-4 text-center text-slate-500 text-sm">
            <p>Brinkley Family PBA Trip 2026 Portal • Safe Travels!</p>
        </div>
    </footer>

    <script>
        let map;
        let markers = [];
        let persistentMarkers = [];

        const persistentLocations = [
            { name: "Palm Beach Atlantic University", lat: 26.7035, lng: -80.0520, type: 'pba', info: "Your campus destination." },
            { name: "The Jaxon", lat: 26.7100, lng: -80.0600, type: 'jaxon', info: "Home base for the trip." }
        ];

        const locations = [
            { name: "True Food Kitchen", lat: 26.7081, lng: -80.0573, cat: "dining", info: "Healthy family dining." },
            { name: "Bolay", lat: 26.7061, lng: -80.0881, cat: "dining", info: "Gluten-free nutrient bowls." },
            { name: "PLANTA", lat: 26.7078, lng: -80.0569, cat: "dining", info: "Plant-based upscale dining." },
            { name: "Warren Library (PBA)", lat: 26.7032, lng: -80.0528, cat: "study", info: "Quiet study on campus." },
            { name: "Subculture Coffee", lat: 26.7126, lng: -80.0558, cat: "study", info: "Industrial vibe coffee." },
            { name: "Mandel Public Library", lat: 26.7135, lng: -80.0545, cat: "study", info: "Huge floors, free Wi-Fi." },
            { name: "Manatee Lagoon", lat: 26.7644, lng: -80.0494, cat: "kids", info: "Free wildlife viewing center." },
            { name: "Palm Beach Zoo", lat: 26.6775, lng: -80.0667, cat: "kids", info: "Interactive & family friendly." },
            { name: "Flagpole Surf Spot", lat: 26.7011, lng: -80.0345, cat: "active", info: "Student favorite surf spot." },
            { name: "Riverbend Park", lat: 26.9328, lng: -80.1744, cat: "active", info: "Kayaking & nature trails." },
            { name: "projectROCK", lat: 26.1833, lng: -80.1417, cat: "active", info: "Premier indoor climbing." },
            { name: "Vineyard Church", lat: 26.6267, lng: -80.1415, cat: "church", info: "Spirit-led 9:30 AM." },
            { name: "Faith Church", lat: 26.7380, lng: -80.1040, cat: "church", info: "Spirit-led 10:00 AM." },
            { name: "Bridge Church", lat: 26.7351, lng: -80.0612, cat: "church", info: "Elder shepherded community." },
            { name: "Journey Church", lat: 26.6340, lng: -80.1380, cat: "church", info: "9:00 & 11:00 AM." },
            { name: "Ballet Florida", lat: 26.7000, lng: -80.0560, cat: "arts", info: "Classical dance practice." },
            { name: "Avenue Pottery", lat: 26.6570, lng: -80.0590, cat: "arts", info: "Ceramics workshops." },
            { name: "Castoffs Square Dance", lat: 26.5255, lng: -80.0664, cat: "arts", info: "Friday Square Dancing." }
        ];

        function initMap() {
            map = L.map('map').setView([26.70, -80.06], 11);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            // Add Persistent Markers
            persistentLocations.forEach(loc => {
                const color = loc.type === 'pba' ? '#4f46e5' : '#ef4444';
                L.circleMarker([loc.lat, loc.lng], {
                    radius: 10,
                    fillColor: color,
                    color: "#fff",
                    weight: 2,
                    opacity: 1,
                    fillOpacity: 1
                }).addTo(map).bindPopup(`<b>${loc.name}</b><br>${loc.info}`);
            });

            renderMarkers('all');
        }

        function renderMarkers(category) {
            markers.forEach(m => map.removeLayer(m));
            markers = [];

            locations.forEach(loc => {
                if (category === 'all' || loc.cat === category) {
                    const m = L.marker([loc.lat, loc.lng]).addTo(map)
                        .bindPopup(`<b>${loc.name}</b><br>${loc.info}`);
                    markers.push(m);
                }
            });

            const allToFit = [...markers];
            if (allToFit.length > 0) {
                const group = new L.featureGroup(allToFit);
                map.fitBounds(group.getBounds().pad(0.2));
            }
        }

        function filterMarkers(category) {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('bg-indigo-600', 'text-white', 'shadow-md');
                btn.classList.add('bg-white', 'border-slate-200');
            });
            event.target.classList.add('bg-indigo-600', 'text-white', 'shadow-md');
            event.target.classList.remove('bg-white', 'border-slate-200');
            
            renderMarkers(category);
        }

        function showPage(pageId) {
            document.querySelectorAll('.tab-content').forEach(p => p.classList.remove('active'));
            document.getElementById(pageId).classList.add('active');
            window.scrollTo(0, 0);
            if(pageId === 'home') setTimeout(() => map.invalidateSize(), 100);
        }

        window.onload = initMap;
    </script>
</body>
</html>